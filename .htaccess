# Kintun - Apache Configuration for cPanel / Shared Hosting

# Default index file
DirectoryIndex index.html index.php

# Prevent directory listing (Mencegah tampilan "Index of /kintun")
Options -Indexes

# Enable rewrite engine
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Route API calls to api.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^api/(.*)$ api.php?route=$1 [QSA,L]
    RewriteRule ^api$ api.php [QSA,L]
</IfModule>

# Security: Proteksi metadata transfer
<FilesMatch "meta\.json|link_.*\.txt">
    Order allow,deny
    Deny from all
</FilesMatch>
